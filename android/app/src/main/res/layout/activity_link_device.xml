<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oaclix_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/native_badge"
            android:textColor="@color/oaclix_accent"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/link_title"
            android:textColor="@color/oaclix_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/link_subtitle"
            android:textColor="@color/oaclix_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/generate_link_code_button"
            style="@style/Widget.Oaclix.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/link_generate_code" />

        <TextView
            android:id="@+id/generated_link_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/local_item_background"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:padding="14dp"
            android:textColor="@color/oaclix_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/link_code_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/share_editor_background"
            android:hint="@string/link_code_hint"
            android:inputType="textVisiblePassword|textCapCharacters"
            android:maxLength="12"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/oaclix_text"
            android:textColorHint="@color/oaclix_muted" />

        <Button
            android:id="@+id/link_device_button"
            style="@style/Widget.Oaclix.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/link_device_action" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/link_devices_title"
                android:textColor="@color/oaclix_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refresh_linked_devices_button"
                style="@style/Widget.Oaclix.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="112dp"
                android:text="@string/link_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linked_devices_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/link_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/link_ready"
            android:textColor="@color/oaclix_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
