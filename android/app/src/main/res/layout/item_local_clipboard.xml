<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/local_item_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/item_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/process_text_recent_background"
                android:clipToOutline="true"
                android:contentDescription="@string/share_image_title"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/item_type_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/process_text_recent_background"
                android:gravity="center"
                android:text="TXT"
                android:textColor="@color/oaclix_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/oaclix_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/item_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/oaclix_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copy_button"
            style="@style/Widget.Oaclix.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/copy"
            android:textSize="13sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/share_button"
            style="@style/Widget.Oaclix.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/share_out"
            android:textSize="13sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/delete_button"
            style="@style/Widget.Oaclix.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/delete"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>