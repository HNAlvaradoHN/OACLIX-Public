<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/share_dialog_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_oaclix_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/process_text_title"
                android:textColor="@color/oaclix_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/process_text_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/process_text_subtitle"
                android:textColor="@color/oaclix_muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/process_text_copy_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/process_text_recent_background"
        android:clickable="true"
        android:focusable="true"
        android:padding="14dp"
        android:text="@string/process_text_copy_selection"
        android:textColor="@color/oaclix_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/process_text_copy_selection_hint"
        android:textColor="@color/oaclix_disabled"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/process_text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/process_text_recent_background"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/process_text_empty"
        android:textColor="@color/oaclix_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/process_text_recent_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/process_text_hint"
        android:textColor="@color/oaclix_disabled"
        android:textSize="11.5sp" />

</LinearLayout>
