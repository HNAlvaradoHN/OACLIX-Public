<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0D0D14" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#242436" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oaclix_accent_soft" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/oaclix_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oaclix_surface_soft" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/oaclix_surface_stroke" />
        </shape>
    </item>
</selector>
