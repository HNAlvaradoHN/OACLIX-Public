{
  "name": "oaclix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:public": "node scripts/audit-public-snapshot.mjs .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.80.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  }
}
