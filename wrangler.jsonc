{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oaclix-public-dev",
  "compatibility_date": "2026-09-07",
  "main": "./worker/main.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "exports": {
    "RealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
